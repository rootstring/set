<?xml version="1.0" encoding="UTF-8"?>
<!-- Applied to every executable in the bundle when release.yml signs it. The hardened runtime revokes capabilities unless named here: without the microphone entitlement a notarized build gets no permission dialog and a device that never opens. Set is not sandboxed (an external process spawns set-mcp), so nothing else is needed. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>

{
  "name": "Set",
  "version": "0.0.2-rc.2",
  "description": "A dead-simple, local-first, block-based note taking app.",
  "private": true,
  "homepage": "https://writewithset.com",
  "repository": "github:rootstring/set",
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,css}\" \"e2e/**/*.ts\"",
    "gen-notes": "node scripts/gen-notes.mjs",
    "gen-icons": "bash scripts/gen-icons.sh",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:perf": "playwright test e2e/perf.spec.ts",
    "tauri": "tauri",
    "tauri:build:local": "tauri build --config src-tauri/tauri.local.conf.json",
    "prepare": "lefthook install"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-code-block": "^3.30.5",
    "@tiptap/extension-code-block-lowlight": "^3.30.5",
    "@tiptap/extension-drag-handle": "^3.30.5",
    "@tiptap/extension-highlight": "^3.30.5",
    "@tiptap/extension-horizontal-rule": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/extension-subscript": "^3.30.5",
    "@tiptap/extension-superscript": "^3.30.5",
    "@tiptap/extension-table": "^3.30.5",
    "@tiptap/extension-task-item": "^3.30.5",
    "@tiptap/extension-task-list": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/suggestion": "^3.30.5",
    "highlight.js": "^11",
    "lowlight": "^3",
    "markdown-it-mark": "^4.0.0",
    "prosemirror-markdown": "^1.13.5",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@fontsource-variable/roboto-serif": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tauri-apps/cli": "^2",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^6.4.3",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ],
    "overrides": {
      "postcss@<8.5.23": "^8.5.23",
      "nanoid@<3.3.18": "^3.3.18"
    }
  }
}
